<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.RemainingApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#252d2d</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="android:statusBarColor">#97aeac</item>
        <item name="colorPrimaryVariant">#000000</item>
        <item name="android:navigationBarColor">#abcac8</item>
        <item name="android:colorBackground">#abcac8</item>
        <item name="floatingActionButtonStyle">@style/CustomFABStyle</item>
        <item name="cardViewStyle">@style/CustomCardViewStyle</item>
        <item name="android:textColor">#000000</item>
    </style>

    <style name="CustomCardViewStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">#252d2d</item>
        <item name="tint">#bfe5e4</item>
    </style>

    <style name="CustomFABStyle" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">#252d2d</item>
        <item name="tint">#bfe5e4</item>
    </style>

    <style name="Theme.RemainingApplication" parent="Base.Theme.RemainingApplication" />
</resources>
